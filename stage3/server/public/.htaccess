# Stage3 shared-hosting public root.
# Use this directory directly, or copy these two files byte-for-byte to the
# Hostinger public_html sibling of the private /stage3 runtime directory.
# The complete Stage3 runtime tree must remain outside every other web root.
# Requires Apache 2.4 / LiteSpeed-compatible mod_rewrite plus
# AllowOverride Options FileInfo Indexes.
# Do not use FallbackResource, RedirectMatch or FilesMatch here.
Options +SymLinksIfOwnerMatch -FollowSymLinks -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny hidden path segments except the literal .well-known segment.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Only the stable front controller may execute from this directory.
    RewriteRule ^(?!index\.php$).+\.(?:php|phtml|phar|cgi|pl)$ - [F,L,NC]

    # Deny common private/config/backup/database/key files.
    RewriteRule \.(?:sqlite|sqlite3|db|sql|bak|log|ini|env|pem|key|p12|pfx)$ - [F,L,NC]

    # Preserve actual files/directories; route application paths to index.php.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>
