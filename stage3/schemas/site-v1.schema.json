        "radius": {
          "enum": [
            "closest-side",
            "farthest-side",
            "farthest-corner"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "via"
            ]
          },
          "then": {
            "required": [
              "viaAt"
            ]
          }
        },
        {
          "if": {
            "required": [
              "viaAt"
            ]
          },
          "then": {
            "required": [
              "via"
            ]
          }
        }
      ]
    },
