            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "via": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "viaAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "type": {
          "enum": [
            "linear",
            "radial"
          ]
        },
