{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manufact.pro/ai-site-cms/site-v1.schema.json",
  "title": "AI Site CMS site document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "siteId",
    "title",
    "schemaVersion",
    "assets",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-ai-site-v1"
    },
    "siteId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "schemaVersion": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "primary",
        "font",
        "maxWidth"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "enum": [
            "system",
            "arial",
            "georgia"
          ]
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 680,
          "maximum": 1600
        }
      }
    },
    "redirects": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "sticky",
        "mobile",
        "ctaPageId",
        "ctaLabel"
      ],
      "properties": {
        "style": {
          "enum": [
            "default",
            "quiet",
            "bold"
          ]
        },
        "sticky": {
          "type": "boolean"
        },
        "mobile": {
          "enum": [
            "collapsible",
            "expanded"
          ]
        },
        "ctaPageId": {
          "type": "string",
          "maxLength": 80
        },
        "ctaLabel": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "alt",
        "mime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "src": {
          "type": "string",
          "pattern": "^/assets/[a-zA-Z0-9/_-]+\\.(png|webp|jpg|jpeg|svg)$"
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        },
        "mime": {
          "enum": [
            "image/png",
            "image/webp",
            "image/jpeg",
            "image/svg+xml"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "robots"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "robots": {
              "enum": [
                "index",
                "noindex"
              ]
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "hidden"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 100
            },
            "hidden": {
              "type": "boolean"
            },
            "parentId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "manifestVersion",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "string"
        },
        "manifestVersion": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/repeatItem"
          }
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "formFields": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/formField"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "repeatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "to": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "spacing",
        "align"
      ],
      "properties": {
        "surface": {
          "enum": [
            "default",
            "paper",
            "tint",
            "dark"
          ]
        },
        "spacing": {
          "enum": [
            "tight",
            "normal",
            "airy"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center"
          ]
        },
        "width": {
          "enum": [
            "default",
            "narrow",
            "wide"
          ]
        },
        "heading": {
          "enum": [
            "default",
            "compact",
            "expressive"
          ]
        },
        "corners": {
          "enum": [
            "default",
            "soft",
            "round"
          ]
        },
        "mobileAlign": {
          "enum": [
            "inherit",
            "left",
            "center"
          ]
        },
        "mobileSpacing": {
          "enum": [
            "inherit",
            "tight",
            "normal",
            "airy"
          ]
        },
        "button": {
          "enum": [
            "default",
            "outline",
            "pill"
          ]
        }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "required",
        "options",
        "placeholder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^field-[a-z][a-z0-9-]{2,49}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "text",
            "tel",
            "email",
            "select",
            "textarea"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "option"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "option": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    }
  }
}
