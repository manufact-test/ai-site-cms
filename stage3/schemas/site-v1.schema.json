{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manufact.pro/ai-site-cms/site-v1.schema.json",
  "title": "AI Site CMS site document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "siteId",
    "title",
    "schemaVersion",
    "assets",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-ai-site-v1"
    },
    "siteId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "schemaVersion": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "primary",
        "font",
        "maxWidth"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "enum": [
            "system",
            "arial",
            "georgia"
          ]
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 680,
          "maximum": 1600
        }
      }
    },
    "redirects": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "sticky",
        "mobile",
        "ctaPageId",
        "ctaLabel"
      ],
      "properties": {
        "style": {
          "enum": [
            "default",
            "quiet",
            "bold"
          ]
        },
        "sticky": {
          "type": "boolean"
        },
        "mobile": {
          "enum": [
            "collapsible",
            "expanded"
          ]
        },
        "ctaPageId": {
          "type": "string",
          "maxLength": 80
        },
        "ctaLabel": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "designTokens": {
      "$ref": "#/$defs/designTokens"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "alt",
        "mime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "src": {
          "type": "string",
          "pattern": "^/assets/[a-zA-Z0-9/_-]+\\.(png|webp|jpg|jpeg|svg)$"
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        },
        "mime": {
          "enum": [
            "image/png",
            "image/webp",
            "image/jpeg",
            "image/svg+xml"
          ]
        },
        "variants": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "src",
              "sha256",
              "width",
              "height"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "src": {
                "type": "string",
                "pattern": "^/assets/[a-z][a-z0-9-]{2,79}\\.(png|jpg|webp)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "enum": [
                  360,
                  720,
                  1200
                ]
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "robots"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "robots": {
              "enum": [
                "index",
                "noindex"
              ]
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "hidden"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 100
            },
            "hidden": {
              "type": "boolean"
            },
            "parentId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "manifestVersion",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "string"
        },
        "manifestVersion": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/repeatItem"
          }
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "formFields": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/formField"
          }
        },
        "designGraph": {
          "$ref": "#/$defs/designGraph"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "repeatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "to": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "spacing",
        "align"
      ],
      "properties": {
        "surface": {
          "enum": [
            "default",
            "paper",
            "tint",
            "dark"
          ]
        },
        "spacing": {
          "enum": [
            "tight",
            "normal",
            "airy"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center"
          ]
        },
        "width": {
          "enum": [
            "default",
            "narrow",
            "wide"
          ]
        },
        "heading": {
          "enum": [
            "default",
            "compact",
            "expressive"
          ]
        },
        "corners": {
          "enum": [
            "default",
            "soft",
            "round"
          ]
        },
        "mobileAlign": {
          "enum": [
            "inherit",
            "left",
            "center"
          ]
        },
        "mobileSpacing": {
          "enum": [
            "inherit",
            "tight",
            "normal",
            "airy"
          ]
        },
        "button": {
          "enum": [
            "default",
            "outline",
            "pill"
          ]
        }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "required",
        "options",
        "placeholder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^field-[a-z][a-z0-9-]{2,49}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "text",
            "tel",
            "email",
            "select",
            "textarea"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "option"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "option": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "designTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "spacing",
        "radii",
        "typography"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        },
        "spacing": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          }
        },
        "radii": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          }
        },
        "typography": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 8,
            "maximum": 120
          }
        }
      }
    },
    "designStyles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "enum": [
            "block",
            "grid",
            "flex",
            "none"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between"
          ]
        },
        "gap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "padding": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "radius": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "fontSize": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "integer",
          "minimum": 80,
          "maximum": 250
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1920
        },
        "position": {
          "enum": [
            "static",
            "relative",
            "absolute"
          ]
        },
        "top": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "left": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "borderColor": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        },
        "hidden": {
          "type": "boolean"
        },
        "rowGap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "columnGap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "paddingX": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "paddingY": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "minHeight": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "marginTop": {
          "type": "integer",
          "minimum": -160,
          "maximum": 160
        },
        "marginBottom": {
          "type": "integer",
          "minimum": -160,
          "maximum": 160
        },
        "widthPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "gridColumnSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "flexWrap": {
          "enum": [
            "nowrap",
            "wrap"
          ]
        },
        "flexGrow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "alignSelf": {
          "enum": [
            "auto",
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "letterSpacing": {
          "type": "integer",
          "minimum": -50,
          "maximum": 200
        },
        "fontFamily": {
          "enum": [
            "inherit",
            "system",
            "arial",
            "georgia",
            "serif",
            "mono"
          ]
        },
        "objectFit": {
          "enum": [
            "cover",
            "contain",
            "fill",
            "none"
          ]
        },
        "aspectRatio": {
          "enum": [
            "auto",
            "square",
            "portrait",
            "landscape",
            "wide"
          ]
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden",
            "auto"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "soft",
            "medium",
            "strong"
          ]
        },
        "gradient": {
          "$ref": "#/$defs/designGradient"
        }
      }
    },
    "designState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "borderColor": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "radius": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gradient": {
          "$ref": "#/$defs/designGradient"
        }
      }
    },
    "designNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "container",
            "heading",
            "text",
            "button",
            "image",
            "divider",
            "icon"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 3000
        },
        "href": {
          "type": "string",
          "maxLength": 300
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "styles": {
          "$ref": "#/$defs/designStyles"
        },
        "responsive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tablet": {
              "$ref": "#/$defs/designStyles"
            },
            "mobile": {
              "$ref": "#/$defs/designStyles"
            }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hover": {
              "$ref": "#/$defs/designState"
            },
            "focus": {
              "$ref": "#/$defs/designState"
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/designNode"
          }
        },
        "icon": {
          "enum": [
            "check",
            "arrow",
            "star",
            "sparkles",
            "shield",
            "clock",
            "mail",
            "play",
            "menu"
          ]
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "duration",
            "delay"
          ],
          "properties": {
            "effect": {
              "enum": [
                "none",
                "fade-in",
                "fade-up",
                "slide-left",
                "zoom-in"
              ]
            },
            "duration": {
              "type": "integer",
              "minimum": 150,
              "maximum": 2000
            },
            "delay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "designGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "nodes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/designNode"
          }
        }
      }
    },
    "designGradient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "from",
        "to"
      ],
      "properties": {
        "angle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        },
        "from": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "to": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        }
      }
    }
  }
}
