{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manufact.pro/ai-site-cms/site-v1.schema.json",
  "title": "AI Site CMS site document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "siteId",
    "title",
    "schemaVersion",
    "assets",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-ai-site-v1"
    },
    "siteId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "language": {
      "enum": [
        "ru",
        "en",
        "pl",
        "de",
        "be",
        "uk"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "notFoundPageId": {
      "$ref": "#/$defs/id",
      "description": "Optional existing hidden, noindex, form-free page used only as a public 404 fallback."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "primary",
        "font",
        "maxWidth"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "enum": [
            "system",
            "arial",
            "georgia"
          ]
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 680,
          "maximum": 1600
        },
        "bodySize": {
          "type": "integer",
          "minimum": 14,
          "maximum": 22
        },
        "lineHeight": {
          "enum": [
            "compact",
            "normal",
            "relaxed"
          ]
        },
        "headingScale": {
          "enum": [
            "compact",
            "normal",
            "large"
          ]
        },
        "buttonStyle": {
          "enum": [
            "solid",
            "outline",
            "pill"
          ]
        },
        "buttonRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "buttonText": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "redirects": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "sticky",
        "mobile",
        "ctaPageId",
        "ctaLabel"
      ],
      "properties": {
        "style": {
          "enum": [
            "default",
            "quiet",
            "bold"
          ]
        },
        "sticky": {
          "type": "boolean"
        },
        "mobile": {
          "enum": [
            "collapsible",
            "expanded"
          ]
        },
        "ctaPageId": {
          "type": "string",
          "maxLength": 80
        },
        "ctaLabel": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "designTokens": {
      "$ref": "#/$defs/designTokens"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice",
        "noticePageId",
        "email",
        "phone",
        "tone",
        "mobile"
      ],
      "properties": {
        "notice": {
          "type": "string",
          "maxLength": 180
        },
        "noticePageId": {
          "type": "string",
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "tone": {
          "enum": [
            "light",
            "dark",
            "primary"
          ]
        },
        "mobile": {
          "enum": [
            "show",
            "hide"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "alt",
        "mime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "src": {
          "type": "string",
          "pattern": "^/assets/[a-zA-Z0-9/_-]+\\.(png|webp|jpg|jpeg|svg|mp4)$"
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        },
        "mime": {
          "enum": [
            "image/png",
            "image/webp",
            "image/jpeg",
            "image/svg+xml",
            "video/mp4"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "variants": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "src",
              "sha256",
              "width",
              "height"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "src": {
                "type": "string",
                "pattern": "^/assets/[a-z][a-z0-9-]{2,79}\\.(png|jpg|webp)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "enum": [
                  360,
                  720,
                  1200
                ]
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            }
          }
        }
      },
      "dependentRequired": {
        "width": [
          "height"
        ],
        "height": [
          "width"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mime": {
                "enum": [
                  "image/svg+xml",
                  "video/mp4"
                ]
              }
            },
            "required": [
              "mime"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "width"
                  ]
                },
                {
                  "required": [
                    "height"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "robots"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "robots": {
              "enum": [
                "index",
                "noindex"
              ]
            },
            "ogTitle": {
              "type": "string",
              "maxLength": 160
            },
            "ogDescription": {
              "type": "string",
              "maxLength": 300
            },
            "ogImage": {
              "oneOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "schemaType": {
              "enum": [
                "none",
                "WebPage",
                "AboutPage",
                "ContactPage",
                "FAQPage"
              ]
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "hidden"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 100
            },
            "hidden": {
              "type": "boolean"
            },
            "parentId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "manifestVersion",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "string"
        },
        "manifestVersion": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/repeatItem"
          }
        },
        "deviceVisibility": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "desktop": {"type": "boolean"},
            "tablet": {"type": "boolean"},
            "mobile": {"type": "boolean"}
          },
          "not": {
            "required": ["desktop", "tablet", "mobile"],
            "properties": {
              "desktop": {"const": false},
              "tablet": {"const": false},
              "mobile": {"const": false}
            }
          }
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "formFields": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/formField"
          }
        },
        "successPageId": {
          "$ref": "#/$defs/id",
          "description": "Optional existing hidden noindex form-free page shown only after an accepted lead. Valid on lead-form and lead-form-flex sections."
        },
        "consentPageId": {
          "$ref": "#/$defs/id",
          "description": "Optional existing non-home information page linked from the real form consent checkbox. Valid only on lead-form and lead-form-flex."
        },
        "designGraph": {
          "$ref": "#/$defs/designGraph"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "repeatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "object"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "to": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "spacing",
        "align"
      ],
      "properties": {
        "surface": {
          "enum": [
            "default",
            "paper",
            "tint",
            "dark"
          ]
        },
        "spacing": {
          "enum": [
            "tight",
            "normal",
            "airy"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center"
          ]
        },
        "width": {
          "enum": [
            "default",
            "narrow",
            "wide",
            "edge"
          ]
        },
        "heading": {
          "enum": [
            "default",
            "compact",
            "expressive"
          ]
        },
        "corners": {
          "enum": [
            "default",
            "soft",
            "round"
          ]
        },
        "mobileAlign": {
          "enum": [
            "inherit",
            "left",
            "center"
          ]
        },
        "mobileSpacing": {
          "enum": [
            "inherit",
            "tight",
            "normal",
            "airy"
          ]
        },
        "button": {
          "enum": [
            "default",
            "solid",
            "outline",
            "pill"
          ]
        }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "required",
        "options",
        "placeholder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^field-[a-z][a-z0-9-]{2,49}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "text",
            "tel",
            "email",
            "select",
            "textarea",
            "radio",
            "checkbox",
            "number",
            "date",
            "url"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "option"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "option": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "designTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "spacing",
        "radii",
        "typography"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        },
        "spacing": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          }
        },
        "radii": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          }
        },
        "typography": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 8,
            "maximum": 120
          }
        }
      }
    },
    "designStyles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "enum": [
            "block",
            "grid",
            "flex",
            "none"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between"
          ]
        },
        "gap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "padding": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "radius": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "fontSize": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "integer",
          "minimum": 80,
          "maximum": 250
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1920
        },
        "position": {
          "enum": [
            "static",
            "relative",
            "absolute",
            "sticky"
          ]
        },
        "top": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "left": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "borderColor": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        },
        "hidden": {
          "type": "boolean"
        },
        "rowGap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "columnGap": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "paddingX": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "paddingY": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "minHeight": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 240
            },
            {
              "type": "string",
              "pattern": "^@[a-z][a-z0-9-]{1,39}$"
            }
          ]
        },
        "marginTop": {
          "type": "integer",
          "minimum": -160,
          "maximum": 160
        },
        "marginBottom": {
          "type": "integer",
          "minimum": -160,
          "maximum": 160
        },
        "widthPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "gridColumnSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "flexWrap": {
          "enum": [
            "nowrap",
            "wrap"
          ]
        },
        "flexGrow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "alignSelf": {
          "enum": [
            "auto",
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "letterSpacing": {
          "type": "integer",
          "minimum": -50,
          "maximum": 200
        },
        "fontFamily": {
          "enum": [
            "inherit",
            "system",
            "arial",
            "georgia",
            "serif",
            "mono"
          ]
        },
        "objectFit": {
          "enum": [
            "cover",
            "contain",
            "fill",
            "none"
          ]
        },
        "aspectRatio": {
          "enum": [
            "auto",
            "square",
            "portrait",
            "landscape",
            "wide"
          ]
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden",
            "auto"
          ]
