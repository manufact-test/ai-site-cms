{
  "format": "manufact-ai-component-v1",
  "id": "process-timeline",
  "version": "1.0.0",
  "label": "Этапы работы · дорожная карта",
  "elements": [
    {
      "slot": "heading",
      "label": "Заголовок секции",
      "fields": [
        {
          "path": "content.text",
          "label": "Заголовок",
          "type": "text",
          "default": "Как проходит работа",
          "responsive": false,
          "maxLength": 180
        }
      ]
    },
    {
      "slot": "description",
      "label": "Введение",
      "fields": [
        {
          "path": "content.text",
          "label": "Пояснение",
          "type": "text",
          "default": "Ниже приведён описанный вами порядок работы.",
          "responsive": false,
          "maxLength": 400
        }
      ]
    }
  ],
  "repeat": {
    "label": "Этап процесса",
    "min": 2,
    "max": 12,
    "fields": [
      {
        "path": "content.title",
        "label": "Название этапа",
        "type": "text",
        "default": "Название этапа",
        "responsive": false,
        "maxLength": 130
      },
      {
        "path": "content.description",
        "label": "Действие и результат",
        "type": "text",
        "default": "Опишите реальное содержание этапа.",
        "responsive": false,
        "maxLength": 500
      },
      {
        "path": "content.detail",
        "label": "Дополнительная подсказка",
        "type": "text",
        "default": "",
        "responsive": false,
        "maxLength": 200
      }
    ]
  }
}
