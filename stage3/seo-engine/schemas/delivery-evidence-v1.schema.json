{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller-supplied bounded HTTP response transcript (not authenticated live observation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "siteId",
    "origin",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-seo-delivery-evidence-v1"
    },
    "siteId": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "requestUrl",
          "responseUrl",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "requestUrl": {
            "type": "string",
            "format": "uri"
          },
          "responseUrl": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "headers": {
            "type": "object",
            "maxProperties": 60,
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "html": {
            "type": "string",
            "maxLength": 500000
          }
        }
      }
    },
    "robots": {
      "$ref": "#/$defs/resource"
    },
    "sitemap": {
      "$ref": "#/$defs/resource"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "body"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "contentType": {
          "type": "string",
          "maxLength": 150
        },
        "body": {
          "type": "string",
          "maxLength": 750000
        }
      }
    }
  }
}
