{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO editorial brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "siteId",
    "title",
    "language",
    "region",
    "audience",
    "goal",
    "facts",
    "research",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-seo-brief-v1"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "language": {
      "enum": [
        "ru",
        "en",
        "pl",
        "de",
        "be",
        "uk"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "status",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "unverified"
            ]
          },
          "origin": {
            "enum": [
              "owner",
              "document",
              "research"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "research": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "observation",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "observation": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "primary-guidance",
              "site-reference",
              "audience-evidence",
              "other"
            ]
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "intent",
        "seo",
        "sections",
        "links",
        "schemaCandidates",
        "responsive"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "name": {
          "type": "string"
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "need",
            "topics"
          ],
          "properties": {
            "type": {
              "enum": [
                "informational",
                "commercial",
                "transactional",
                "navigational",
                "support"
              ]
            },
            "need": {
              "type": "string"
            },
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "robots"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "robots": {
              "enum": [
                "index",
                "noindex"
              ]
            },
            "ogTitle": {
              "type": "string",
              "maxLength": 160
            },
            "ogDescription": {
              "type": "string",
              "maxLength": 300
            },
            "canonicalPath": {
              "type": "string"
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toPageId",
              "anchor",
              "why"
            ],
            "properties": {
              "toPageId": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "schemaCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "factIds",
              "why"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Organization",
                  "LocalBusiness",
                  "BreadcrumbList",
                  "Article",
                  "Product",
                  "Service",
                  "FAQPage"
                ]
              },
              "factIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "responsive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desktop",
            "tablet",
            "mobile"
          ],
          "properties": {
            "desktop": {
              "type": "string"
            },
            "tablet": {
              "type": "string"
            },
            "mobile": {
              "type": "string"
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heading",
        "level",
        "why",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "why": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "alt",
            "why"
          ],
          "properties": {
            "purpose": {
              "enum": [
                "informative",
                "decorative"
              ]
            },
            "alt": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "toPageId",
            "purpose"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "toPageId": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            }
          }
        },
        "interaction": {
          "type": "string"
        }
      }
    }
  }
}
