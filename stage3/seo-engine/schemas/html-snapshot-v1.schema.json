{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted bounded static HTML snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "pages"
  ],
  "properties": {
    "format": {
      "const": "manufact-seo-html-snapshot-v1"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "completeness": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "pages": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "html"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,79}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/(?:[a-z0-9-]+/)*$"
          },
          "html": {
            "type": "string",
            "maxLength": 500000
          }
        }
      }
    },
    "sitemapPaths": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "string"
      }
    },
    "robotsTxt": {
      "type": "string",
      "maxLength": 250000
    },
    "sitemapCompleteness": {
      "enum": [
        "partial",
        "complete"
      ],
      "description": "Only complete permits treating an omitted indexable Site v1 route as missing from sitemapPaths. Defaults to partial-or-unknown."
    },
    "mountPath": {
      "type": "string",
      "pattern": "^/published/[a-z][a-z0-9-]{2,79}/$",
      "description": "Optional actual Stage3 PHP mount used to normalize captured links to logical Site v1 paths; must match siteId."
    },
    "redirectPaths": {
      "type": "array",
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?:[a-z0-9-]+/)*$"
      },
      "description": "Only aliases whose real local PHP responses were independently seen as matching HTTP 301; no claim of public HTTPS."
    },
    "source": {
      "type": "string",
      "maxLength": 100
    },
    "localHttpOnly": {
      "type": "boolean"
    },
    "sourceRevisionAuthenticated": {
      "type": "boolean"
    }
  }
}
