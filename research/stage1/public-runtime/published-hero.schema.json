{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "fontSize",
    "accent",
    "cta"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "fontSize": {
      "type": "string",
      "pattern": "^[0-9]{1,3}px$"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "cta": {
      "type": "string",
      "maxLength": 200
    }
  }
}
