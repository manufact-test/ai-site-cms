# AI Site CMS Stage2 / Apache 2.4 - distributed PUBLIC root only.
# DocumentRoot MUST be /path/to/cms/public; NEVER the package root.
# Shared hosting must permit AllowOverride Options Indexes FileInfo AuthConfig.
# Locally validated Apache policy; NOT LiteSpeed/Hostinger certification.
Options -Indexes -MultiViews -FollowSymLinks -SymLinksIfOwnerMatch
DirectoryIndex index.php
FallbackResource /index.php

# Match ANY hidden PATH SEGMENT, not just the final filename.
# Only the literal .well-known directory segment is exempt (ACME/security.txt).
# A nested .well-known/.git/config is still forbidden. Requires mod_alias.
# No mod_rewrite: rewrite rules are disallowed when BOTH symlink modes are off.
RedirectMatch 403 "(^|/)\.(?!well-known(/|$))[^/]+(/|$)"

# Defense in depth for individual hidden files, unsafe executables or secrets.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(?!index\.php$).+\.(?:php|phtml|phar|cgi|pl)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:sqlite|sqlite3|db|sql|bak|log|ini|env|pem|key|p12|pfx)$">
    Require all denied
</FilesMatch>
