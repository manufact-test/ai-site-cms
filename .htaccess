# Stage2 host capabilities ONLY. Not a CMS / no secrets in this Git branch.
Options -Indexes -MultiViews -FollowSymLinks
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(?!index\.php$).+\.(?:php|phtml|phar|cgi|pl)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:sql|bak|db|sqlite|ini|env|pem|key|log|p12|pfx)$">
    Require all denied
</FilesMatch>
RewriteEngine On
# Refuse all dot-directories (including a deployed .git/config) and dotfiles.
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
